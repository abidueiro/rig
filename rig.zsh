# =============================================================================
# rig — Terminal Resource Interactive Guide
# Add to .zshrc:  source ~/.config/zsh/rig.zsh  (or wherever your dotfiles are)
#
# IMPORTANT: must be a function (not a script) so that cd works
# in the parent shell.
#
# Navigation:
#   Esc on a submenu  → back to main menu
#   Esc on main menu  → exit rig
#   Q (Quit option)   → exit rig
#   Ctrl+C            → exit rig cleanly from anywhere
# =============================================================================

function rig() {

  # ── Ctrl+C → clean exit from anywhere inside rig ─────────────────────────
  trap 'trap - INT; return 0' INT

  # ── Load configuration (generated by install.sh) ─────────────────────────
  local _conf="${XDG_CONFIG_HOME:-$HOME/.config}/rig/rig.conf"
  if [[ -f "$_conf" ]]; then
    source "$_conf"
  else
    # Defaults: everything enabled when no config file is present
    RIG_NAV_FILES=true; RIG_NAV_DIRS=true; RIG_NAV_DIRS_ZOXIDE=true; RIG_NAV_TEXT=true
    RIG_DEV_DOCKER=true; RIG_DEV_DJANGO=true; RIG_DEV_PYTHON=true; RIG_DEV_GIT=true
    RIG_DEV_TMUX=true
    RIG_SYS_LOGS=true; RIG_SYS_SYSTEMD=true; RIG_SYS_PROCS=true; RIG_SYS_BACKUP=false
    RIG_NET_PORTS=true; RIG_NET_SSH=true; RIG_NET_WG=true
    RIG_TOOL_CHEAT=true; RIG_TOOL_ENV=true; RIG_TOOL_WEATHER=true
    RIG_DJANGO_LOG="logs/django.log"
    RIG_BACKUP_SOURCE="$HOME"
    RIG_BACKUP_DESTINATIONS=""
    RIG_BACKUP_EXCLUDES_FILE="$HOME/rsync_exclude.txt"
    RIG_HOSTS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/rig/hosts.conf"
    RIG_TEMPLATES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rig/templates"
    RIG_USE_SSHUB=true
  fi

  # ── gum colors / styles ───────────────────────────────────────────────────
  local GUM_CHOOSE_CURSOR_FOREGROUND="212"   # pink
  local GUM_CHOOSE_SELECTED_FOREGROUND="212"
  local GUM_CHOOSE_HEADER_FOREGROUND="99"    # violet

  # ── Build menu (once, before the loop) ───────────────────────────────────
  local _menu=()
  [[ "$RIG_NAV_FILES"    == true ]] && _menu+=("[nav]   📁  Browse files")
  [[ "$RIG_NAV_DIRS"     == true ]] && _menu+=("[nav]   📂  Browse directories (cd)")
  [[ "$RIG_NAV_TEXT"     == true ]] && _menu+=("[nav]   🔍  Search file contents")
  [[ "$RIG_DEV_DOCKER"   == true ]] && _menu+=("[dev]   🐋  Docker")
  [[ "$RIG_DEV_DJANGO"   == true ]] && _menu+=("[dev]   🐍  Django (current project)")
  [[ "$RIG_DEV_PYTHON"   == true ]] && _menu+=("[dev]   🐍  Python venvs / uv")
  [[ "$RIG_DEV_GIT"      == true ]] && _menu+=("[dev]   🔀  Git")
  [[ "$RIG_DEV_TMUX"     == true ]] && _menu+=("[dev]   🪟  Tmux / Sesh")
  [[ "$RIG_SYS_LOGS"     == true ]] && _menu+=("[sys]   📋  System logs")
  [[ "$RIG_SYS_SYSTEMD"  == true ]] && _menu+=("[sys]   🔩  Systemd services")
  [[ "$RIG_SYS_PROCS"    == true ]] && _menu+=("[sys]   📊  Processes")
  [[ "$RIG_SYS_BACKUP"   == true ]] && _menu+=("[sys]   💾  Backup (rsync)")
  [[ "$RIG_NET_PORTS"    == true ]] && _menu+=("[net]   📡  Ports / Connections")
  [[ "$RIG_NET_SSH"      == true ]] && _menu+=("[net]   🔌  SSH")
  [[ "$RIG_NET_WG"       == true ]] && _menu+=("[net]   🔒  WireGuard (wgs)")
  [[ "$RIG_TOOL_CHEAT"   == true ]] && _menu+=("[tool]  📖  Cheat sheets")
  [[ "$RIG_TOOL_ENV"     == true ]] && _menu+=("[tool]  🌿  Environment variables")
  [[ "$RIG_TOOL_WEATHER" == true ]] && _menu+=("[tool]  🌤  Weather (wttr.in)")
  _menu+=("[quit]  ❌  Quit")

  # ── Main loop ─────────────────────────────────────────────────────────────
  # Esc on main menu → exit. Esc on any submenu → continue → back here.
  while true; do

    local section
    section=$(printf '%s\n' "${_menu[@]}" \
      | gum filter \
          --header "  rig — type to filter · [nav] [dev] [sys] [net] [tool]" \
          --placeholder "search..." \
          --height 20)

    [[ -z "$section" ]]        && break   # Esc on main menu → exit
    [[ "$section" == *"Quit"* ]] && break   # Q → exit

    case "$section" in

    # ── Files ───────────────────────────────────────────────────
    *"Browse files")
      local scope
      scope=$(gum choose \
        --header "  Browse files from...  (Esc: back)" \
        "Current directory" \
        "Home (~)")
      [[ -z "$scope" ]] && continue
      case "$scope" in
        "Current directory") tv files-open ;;
        "Home (~)")          (cd ~ && tv files-open) ;;
      esac
      ;;

    # ── Directories + cd ────────────────────────────────────────
    *"Browse directories (cd)")
      local scope
      scope=$(gum choose \
        --header "  Navigate directories from...  (Esc: back)" \
        "Current directory" \
        "Home (~)" \
        "Zoxide (history)")
      [[ -z "$scope" ]] && continue
      local target_dir="" base_dir=""
      case "$scope" in
        "Current directory")
          base_dir="$PWD"
          target_dir=$(fd -t d --exclude .git --exclude node_modules \
            --exclude __pycache__ --exclude .venv --exclude target --exclude .cache \
            . 2>/dev/null \
            | fzf --preview 'ls -la --color=always {}' --height 80% --border \
                  --header 'Esc: back')
          [[ -n "$target_dir" ]] && target_dir="${base_dir}/${target_dir}"
          ;;
        "Home (~)")
          base_dir="$HOME"
          target_dir=$(cd ~ && fd -t d --exclude .git --exclude node_modules \
            --exclude __pycache__ --exclude .venv --exclude target --exclude .cache \
            . 2>/dev/null \
            | fzf --preview 'ls -la --color=always {}' --height 80% --border \
                  --header 'Esc: back')
          [[ -n "$target_dir" ]] && target_dir="${base_dir}/${target_dir}"
          ;;
        "Zoxide (history)")
          target_dir=$(zoxide query --interactive 2>/dev/null)
          ;;
      esac
      target_dir=$(echo "$target_dir" | tr -d '\n')
      if [[ -n "$target_dir" && -d "$target_dir" ]]; then
        cd "$target_dir" && echo "  → $target_dir"
      fi
      ;;

    # ── File content search ─────────────────────────────────────
    *"Search file contents")
      local scope
      scope=$(gum choose \
        --header "  Search text in...  (Esc: back)" \
        "Current directory" \
        "Home (~)")
      [[ -z "$scope" ]] && continue
      case "$scope" in
        "Current directory")
          local selection
          selection=$(rg --column --line-number --no-heading --color=always --smart-case \
            --hidden --follow \
            -g '!*.git*' -g '!node_modules' -g '!__pycache__' -g '!.venv' -g '!target' -g '!.cache' \
            . 2>/dev/null \
            | fzf --ansi \
                  --preview 'bat --style=numbers --color=always {1} --highlight-line {2} 2>/dev/null' \
                  --preview-window 'right:60%:+{2}+3/3' \
                  --delimiter ':' \
                  --header 'Recursive search | Enter: select | Esc: back' \
                  --header-first)
          if [[ -n "$selection" ]]; then
            local file=$(echo "$selection" | cut -d':' -f1)
            local line=$(echo "$selection" | cut -d':' -f2)
            echo "📄 $file:$line"
          fi
          ;;
        "Home (~)")
          local selection
          selection=$(cd ~ && rg --column --line-number --no-heading --color=always --smart-case \
            --hidden --follow \
            -g '!*.git*' -g '!node_modules' -g '!__pycache__' -g '!.venv' -g '!target' -g '!.cache' \
            . 2>/dev/null \
            | fzf --ansi \
                  --preview 'cd ~ && bat --style=numbers --color=always {1} --highlight-line {2} 2>/dev/null' \
                  --preview-window 'right:60%:+{2}+3/3' \
                  --delimiter ':' \
                  --header 'Recursive search in home | Enter: select | Esc: back' \
                  --header-first)
          if [[ -n "$selection" ]]; then
            local file=$(echo "$selection" | cut -d':' -f1)
            local line=$(echo "$selection" | cut -d':' -f2)
            echo "📄 ~/$file:$line"
          fi
          ;;
      esac
      ;;

    # ── Docker ──────────────────────────────────────────────────
    *"Docker")
      local docker_action
      docker_action=$(gum choose \
        --header "  Docker  (Esc: back)" \
        "🐳  lazydocker (full TUI)" \
        "🌍  lazydocker en un servidor (lzd)" \
        "📜  Logs de contenedor en lnav, local o servidor (dlog)" \
        "🐚  Shell en contenedor, local o servidor (dsh)" \
        "📋  Containers (inspect / logs / shell / restart / stop)" \
        "📦  Images" \
        "🌐  Networks" \
        "💾  Volumes" \
        "📝  docker-compose: current project services")
      [[ -z "$docker_action" ]] && continue
      case "$docker_action" in
        "🐳  lazydocker"*)   lazydocker ;;
        "🌍  lazydocker en"*) lzd ;;
        "📜  Logs de contenedor"*) dlog ;;
        "🐚  Shell en contenedor"*) dsh ;;
        "📋  Containers"*)   tv docker-all ;;
        "📦  Images")
          docker images --format '{{.Repository}}:{{.Tag}}\t{{.Size}}\t{{.ID}}' | tv ;;
        "🌐  Networks")
          docker network ls --format '{{.Name}}\t{{.Driver}}\t{{.ID}}' | tv ;;
        "💾  Volumes")
          docker volume ls --format '{{.Name}}\t{{.Driver}}' | tv ;;
        "📝  docker-compose"*)
          if [[ -f "docker-compose.yml" || -f "docker-compose.yaml" || -f "compose.yml" ]]; then
            docker compose ps --format 'table {{.Name}}\t{{.Status}}\t{{.Image}}' | tv
          else
            gum style --foreground 196 "  No docker-compose.yml found in current directory"
            sleep 2
          fi
          ;;
      esac
      ;;

    # ── System logs ─────────────────────────────────────────────
    *"System logs")
      local _log_opts=(
        "journalctl — search services (fzf + preview)"
        "journalctl — follow service live"
        "systemd — boot log"
        "kernel — dmesg"
      )
      local _log_labels=() _log_paths=()
      if [[ -n "${RIG_LOG_FILES:-}" ]]; then
        local IFS='|'
        for _entry in $RIG_LOG_FILES; do
          local _label="${_entry%%:*}"
          local _path="${_entry#*:}"
          _log_labels+=("$_label")
          _log_paths+=("$_path")
          _log_opts+=("$_label")
        done
        unset IFS
      fi
      local log_choice
      log_choice=$(gum choose \
        --header "  System logs — which one?  (Esc: back)" \
        "${_log_opts[@]}")
      [[ -z "$log_choice" ]] && continue
      case "$log_choice" in
        "journalctl — search services"*)
          local unit
          unit=$(systemctl list-units --type=service --all --no-pager --plain 2>/dev/null \
            | awk 'NR>1 && NF>1 {print $1}' \
            | fzf --preview 'journalctl -u {} --no-pager -n 30 --output=short-precise 2>/dev/null' \
                  --preview-window 'right:60%' \
                  --header 'Esc: back | Enter: follow live' \
                  --height 80% --border)
          [[ -n "$unit" ]] && journalctl -u "$unit" -f --output=short-precise
          ;;
        "journalctl — follow service live")
          local unit
          unit=$(systemctl list-units --type=service --all --no-pager --plain 2>/dev/null \
            | awk 'NR>1 && NF>1 {print $1}' \
            | fzf --header 'Select service | Esc: back' --height 80% --border)
          [[ -n "$unit" ]] && journalctl -u "$unit" -f --output=short-precise
          ;;
        "systemd — boot log"*)
          _rig_log_menu "journalctl-boot" "journalctl -b --no-pager" ;;
        "kernel — dmesg"*)
          _rig_log_menu "dmesg" "dmesg" ;;
        *)
          local _i=0
          for _lbl in "${_log_labels[@]}"; do
            if [[ "$log_choice" == "$_lbl" ]]; then
              _rig_log_menu "${_log_paths[$_i]}"
              break
            fi
            (( _i++ ))
          done
          ;;
      esac
      ;;

    # ── Systemd services ────────────────────────────────────────
    *"Systemd services")
      while true; do
        local service_action
        service_action=$(gum choose \
          --header "  Systemd  (Esc: back to main)" \
          "🔍  All services" \
          "🟢  Active (running)" \
          "🔴  Failed")
        [[ -z "$service_action" ]] && break   # Esc → back to main loop

        local list_cmd=""
        case "$service_action" in
          "🔍  All services"*)
            list_cmd="systemctl list-units --type=service --all --no-pager --plain 2>/dev/null | awk 'NR>1 && NF>1 {print \$1, \$3, \$4}'" ;;
          "🟢  Active"*)
            list_cmd="systemctl list-units --type=service --state=running --no-pager --plain 2>/dev/null | awk 'NR>1 && NF>1 {print \$1, \$3, \$4}'" ;;
          "🔴  Failed"*)
            list_cmd="systemctl list-units --type=service --state=failed --no-pager --plain 2>/dev/null | awk 'NR>1 && NF>1 {print \$1, \$3, \$4}'" ;;
        esac

        local selected
        selected=$(eval "$list_cmd" | fzf \
          --header 'Esc: back | Enter: manage service' \
          --preview 'systemctl status {1} 2>/dev/null | head -20' \
          --preview-window 'right:60%' --height 80% --border)
        [[ -z "$selected" ]] && continue   # Esc on list → back to filter

        local service svc_status
        service=$(echo "$selected" | awk '{print $1}')
        svc_status=$(echo "$selected" | awk '{print $2}')

        while true; do
          local action
          action=$(gum choose \
            --header "  $service ($svc_status)  (Esc: back)" \
            "▶️  Start" "⏹️  Stop" "🔄  Restart" \
            "📊  Status" "⚡  Enable" "🚫  Disable")
          [[ -z "$action" ]] && break   # Esc → back to service list
          case "$action" in
            "▶️  Start")
              sudo systemctl start   "$service" 2>/dev/null \
                && gum style --foreground 82  "  ✓ $service started" \
                || gum style --foreground 196 "  ✗ Could not start $service" ;;
            "⏹️  Stop")
              sudo systemctl stop    "$service" 2>/dev/null \
                && gum style --foreground 82  "  ✓ $service stopped" \
                || gum style --foreground 196 "  ✗ Could not stop $service" ;;
            "🔄  Restart")
              sudo systemctl restart "$service" 2>/dev/null \
                && gum style --foreground 82  "  ✓ $service restarted" \
                || gum style --foreground 196 "  ✗ Could not restart $service" ;;
            "📊  Status")   systemctl status "$service" | less -R ;;
            "⚡  Enable")
              sudo systemctl enable  "$service" 2>/dev/null \
                && gum style --foreground 82  "  ✓ $service enabled" \
                || gum style --foreground 196 "  ✗ Could not enable $service" ;;
            "🚫  Disable")
              sudo systemctl disable "$service" 2>/dev/null \
                && gum style --foreground 82  "  ✓ $service disabled" \
                || gum style --foreground 196 "  ✗ Could not disable $service" ;;
          esac
          sleep 1
        done
      done
      ;;

    # ── Django ──────────────────────────────────────────────────
    *"Django (current project)")
      local django_log="${RIG_DJANGO_LOG:-logs/django.log}"
      if [[ ! -f "$django_log" ]]; then
        gum style --foreground 196 "  Log not found: $PWD/$django_log"
        sleep 2
        continue
      fi
      local django_action
      django_action=$(gum choose \
        --header "  Django logs — $PWD/$django_log  (Esc: back)" \
        "Search in logs (tv)" \
        "Follow live (less +F)" \
        "Last 200 lines (bat)" \
        "Errors and exceptions only" \
        "Warnings only")
      [[ -z "$django_action" ]] && continue
      case "$django_action" in
        "Search in logs (tv)")      cat "$django_log" | tv ;;
        "Follow live"*)             less +F "$django_log" ;;
        "Last 200 lines"*)          tail -200 "$django_log" | bat --color=always -l log ;;
        "Errors and exceptions only")
          grep -iE "error|exception|traceback|critical" "$django_log" | tv ;;
        "Warnings only")
          grep -iE "warning|warn" "$django_log" \
            | grep -viE "error|exception|traceback|critical" | tv ;;
      esac
      ;;

    # ── Python venvs / uv ───────────────────────────────────────
    *"Python venvs / uv")
      local venv_action
      venv_action=$(gum choose \
        --header "  Python venvs  (Esc: back)" \
        "📂  List venvs in ~/.venvs" \
        "📂  List venvs in current project" \
        "🔍  Search venvs with fd" \
        "➕  Create new venv (uv venv)")
      [[ -z "$venv_action" ]] && continue
      case "$venv_action" in
        "📂  List venvs in ~/.venvs")
          if [[ -d "$HOME/.venvs" ]]; then
            local venvs selected
            venvs=$(ls -1 "$HOME/.venvs" 2>/dev/null)
            if [[ -z "$venvs" ]]; then
              gum style --foreground 196 "  No venvs found in ~/.venvs"; sleep 2
            else
              selected=$(echo "$venvs" | fzf --header 'Select venv | Esc: back' --height 80% --border)
              [[ -n "$selected" ]] && source "$HOME/.venvs/$selected/bin/activate" \
                && echo "  ✓ Activated: $selected"
            fi
          else
            gum style --foreground 196 "  ~/.venvs does not exist"; sleep 2
          fi
          ;;
        "📂  List venvs in current project")
          local venv_dirs selected
          venv_dirs=$(fd -t d -H -I -E .git -E node_modules -E __pycache__ \
            '^(\.venv|venv|env|\.env)$' . 2>/dev/null)
          if [[ -z "$venv_dirs" ]]; then
            gum style --foreground 196 "  No venvs found in current project"; sleep 2
          else
            selected=$(echo "$venv_dirs" | fzf \
              --header 'Select venv | Esc: back' \
              --preview 'ls -la {}/bin 2>/dev/null | head -10' --height 80% --border)
            [[ -n "$selected" ]] && source "$selected/bin/activate" \
              && echo "  ✓ Activated: $selected"
          fi
          ;;
        "🔍  Search venvs with fd")
          local all_venvs selected
          all_venvs=$(fd -t d -H -I -E .git -E node_modules -E __pycache__ \
            '^(\.venv|venv|env)$' ~ 2>/dev/null | head -20)
          if [[ -z "$all_venvs" ]]; then
            gum style --foreground 196 "  No venvs found"; sleep 2
          else
            selected=$(echo "$all_venvs" | fzf \
              --header 'Select venv | Esc: back' \
              --preview 'ls -la {}/bin 2>/dev/null | head -10' --height 80% --border)
            [[ -n "$selected" ]] && source "$selected/bin/activate" \
              && echo "  ✓ Activated: $selected"
          fi
          ;;
        "➕  Create new venv (uv venv)")
          local venv_name
          venv_name=$(gum input --placeholder "Venv name (e.g. .venv)")
          if [[ -n "$venv_name" ]]; then
            if command -v uv &>/dev/null; then
              uv venv "$venv_name" && echo "  ✓ Created with uv: $venv_name"
            else
              python3 -m venv "$venv_name" && echo "  ✓ Created: $venv_name"
            fi
            gum confirm "Activate now?" && source "$venv_name/bin/activate" \
              && echo "  ✓ Activated"
          fi
          ;;
      esac
      ;;

    # ── Git ─────────────────────────────────────────────────────
    *"Git")
      if ! git rev-parse --git-dir &>/dev/null; then
        gum style --foreground 196 "  Not inside a git repository"
        sleep 2; continue
      fi
      local git_action
      git_action=$(gum choose \
        --header "  Git — $(git rev-parse --show-toplevel | xargs basename)  (Esc: back)" \
        "🦥  gitui (full TUI)" \
        "📝  Log — search commits" \
        "🌿  Branches — checkout" \
        "💾  Stash — view and apply" \
        "📁  Modified files" \
        "🏠  Git repos in ~")
      [[ -z "$git_action" ]] && continue
      case "$git_action" in
        "🦥  gitui"*)         gitui ;;
        "📝  Log"*)           tv git-log ;;
        "🌿  Branches"*)      tv git-branches ;;
        "💾  Stash"*)         tv git-stash ;;
        "📁  Modified files") tv git-modified ;;
        "🏠  Git repos in ~") tv git-repos ;;
      esac
      ;;

    # ── Tmux / Sesh ─────────────────────────────────────────────
    *"Tmux / Sesh")
      while true; do
        local tmux_action
        tmux_action=$(gum choose \
          --header "  Tmux / Sesh  (Esc: back to main)" \
          "🔗  Connect to session" \
          "➕  New session" \
          "🗑️  Kill session" \
          "🚀  Launch workflow template")
        [[ -z "$tmux_action" ]] && break
        case "$tmux_action" in
          *"Connect"*)   _rig_tmux_connect ;;
          *"New"*)       _rig_tmux_new ;;
          *"Kill"*)      _rig_tmux_kill ;;
          *"template"*)  _rig_tmux_template ;;
        esac
      done
      ;;

    # ── Processes ───────────────────────────────────────────────
    *"Processes")
      while true; do
        local proc_action
        proc_action=$(gum choose \
          --header "  Processes  (Esc: back to main)" \
          "🔍  Browse and manage processes" \
          "📊  Top by CPU" \
          "📊  Top by memory")
        [[ -z "$proc_action" ]] && break   # Esc → back to main loop

        local get_cmd=""
        case "$proc_action" in
          "🔍  Browse"*)        get_cmd="ps aux --sort=-%cpu 2>/dev/null" ;;
          "📊  Top by CPU"*)    get_cmd="ps aux --sort=-%cpu 2>/dev/null | head -50" ;;
          "📊  Top by memory"*) get_cmd="ps aux --sort=-%mem 2>/dev/null | head -50" ;;
        esac

        while true; do
          local selected
          selected=$(eval "$get_cmd" \
            | fzf --header 'Esc: back | Enter: manage process' \
                  --preview 'echo {} | awk "{print \$2}" | xargs -I % sh -c "ps -f -p % 2>/dev/null || echo PID: %"' \
                  --preview-window 'right:50%' --height 80% --border)
          [[ -z "$selected" ]] && break   # Esc → back to process type menu

          local pid pname
          pid=$(echo "$selected" | awk '{print $2}')
          pname=$(echo "$selected" | awk '{print $11}')
          [[ "$pid" =~ ^[0-9]+$ ]] && _rig_process_menu "$pid" "$pname"
        done
      done
      ;;

    # ── Ports / Connections ─────────────────────────────────────
    *"Ports / Connections")
      local port_action
      port_action=$(gum choose \
        --header "  Ports  (Esc: back)" \
        "🔍  Listening ports (ss -tulpn)" \
        "📊  Established connections (ss -tunp)" \
        "🌐  All connections by state (ss -tunap)")
      [[ -z "$port_action" ]] && continue
      case "$port_action" in
        "🔍  Listening ports"*)
          local selected
          selected=$(ss -tulpn 2>/dev/null | grep -v "^Netid" | fzf \
            --header 'Esc: back | Enter: inspect process' \
            --preview 'echo {} | awk "{print \$7}" | grep -oP "pid=\K[0-9]+" | xargs -I % sh -c "ps -f -p % 2>/dev/null || echo No info"' \
            --preview-window 'right:50%' --height 80% --border)
          if [[ -n "$selected" ]]; then
            local pid
            pid=$(echo "$selected" | grep -oP "pid=\K[0-9]+")
            [[ -n "$pid" ]] && _rig_process_menu "$pid" \
              "$(echo "$selected" | awk '{print $7}' | grep -oP 'name=\K[^:]+')"
          fi
          ;;
        "📊  Established connections"*) ss -tunp  2>/dev/null | less -S ;;
        "🌐  All connections"*)         ss -tunap 2>/dev/null | less -S ;;
      esac
      ;;

    # ── SSH ─────────────────────────────────────────────────────
    *"SSH")
      while true; do
        local ssh_action
        local -a _ssh_menu=(
          "🔌  Connect to host"
          "📁  Mount filesystem (sshfs)"
          "🌐  SOCKS proxy tunnel"
          "🔀  Port forward tunnel"
          "🖥️   Run remote app (X11)"
          "📋  Manage saved hosts"
        )
        [[ "$RIG_USE_SSHUB" == true ]] && _rig_sshub_available && \
          _ssh_menu=("🚀  Open sshub TUI" "${_ssh_menu[@]}")
        ssh_action=$(gum choose \
          --header "  SSH  (Esc: back to main)" \
          "${_ssh_menu[@]}")
        [[ -z "$ssh_action" ]] && break
        case "$ssh_action" in
          *"Open sshub"*)   sshub ;;
          *"Connect"*)      _rig_ssh_connect ;;
          *"Mount"*)        _rig_ssh_sshfs ;;
          *"SOCKS"*)        _rig_ssh_socks ;;
          *"Port forward"*) _rig_ssh_tunnel ;;
          *"remote app"*)   _rig_ssh_remote_app ;;
          *"Manage saved"*) _rig_hosts_manage ;;
        esac
      done
      ;;

    # ── Backup ──────────────────────────────────────────────────
    *"Backup (rsync)")
      local _backup_src="${RIG_BACKUP_SOURCE:-$HOME}"
      local _excludes="${RIG_BACKUP_EXCLUDES_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/rig/rsync-excludes.txt}"

      # Build destination list: saved hosts + configured destinations + ad-hoc picker
      local _dest_list=()
      # Saved rig hosts
      local _hf="${RIG_HOSTS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/rig/hosts.conf}"
      if [[ -f "$_hf" ]]; then
        while IFS='|' read -r _n _u _h _p _d || [[ -n "$_n" ]]; do
          [[ "$_n" == \#* || -z "$_n" ]] && continue
          _dest_list+=("[saved] ${_n}  ${_u}@${_h}:${_p}  — ${_d}")
        done < "$_hf"
      fi
      # Pre-configured destinations from rig.conf
      if [[ -n "${RIG_BACKUP_DESTINATIONS:-}" ]]; then
        local IFS='|'
        for _d in $RIG_BACKUP_DESTINATIONS; do
          _dest_list+=("[conf]  $_d")
        done
        unset IFS
      fi
      _dest_list+=("🔌  Pick any SSH host...")

      local backup_action
      backup_action=$(gum choose \
        --header "  Backup  (Esc: back)" \
        "▶️   Run backup" \
        "🔍  Dry run (preview changes)" \
        "📋  View last backup log")
      [[ -z "$backup_action" ]] && continue

      if [[ "$backup_action" == "📋"* ]]; then
        local _log_file="$HOME/.local/share/rig/backup.log"
        [[ -f "$_log_file" ]] && less -R "$_log_file" \
          || { gum style --foreground 196 "  No backup log yet."; sleep 2; }
        continue
      fi

      # Select destination
      local dest_raw dest=""
      dest_raw=$(printf '%s\n' "${_dest_list[@]}" \
        | gum filter --header "  Select destination  (Esc: back)" --placeholder "filter...")
      [[ -z "$dest_raw" ]] && continue

      if [[ "$dest_raw" == "🔌"* ]]; then
        # Ad-hoc SSH host picker using unified picker
        local _picked
        _picked=$(_rig_hosts_pick "Select SSH host for backup")
        [[ -z "$_picked" ]] && continue
        # Parse: type|name|user|host|port
        local _type _name _user _host _port
        IFS='|' read -r _type _name _user _host _port <<< "$_picked"
        if [[ "$_type" == "sshub" ]]; then
          local _resolved
          _resolved=$(_rig_sshub_resolve "$_name")
          IFS='|' read -r _user _host _port <<< "$_resolved"
        fi
        local _rpath
        _rpath=$(gum input --value "/home/$USER" \
          --prompt "  remote backup path › " --placeholder "Remote directory")
        [[ -z "$_rpath" ]] && continue
        dest="${_user}@${_host}:${_rpath}"
        [[ "$_port" != "22" ]] && \
          gum style --foreground 245 "  Note: non-standard port $_port — rsync uses default SSH. Add to ~/.ssh/config for custom ports."
      elif [[ "$dest_raw" == "[saved]"* ]]; then
        # Saved rig host — parse name to get connection details
        local _sname
        _sname=$(echo "$dest_raw" | awk '{print $2}')
        local _su _sh _sp
        while IFS='|' read -r _n _u _h _p _d || [[ -n "$_n" ]]; do
          [[ "$_n" == \#* || -z "$_n" ]] && continue
          if [[ "$_n" == "$_sname" ]]; then _su="$_u" _sh="$_h" _sp="$_p"; break; fi
        done < "$_hf"
        local _rpath
        _rpath=$(gum input --value "/home/$_su" \
          --prompt "  remote backup path › " --placeholder "Remote directory")
        [[ -z "$_rpath" ]] && continue
        dest="${_su}@${_sh}:${_rpath}"
      else
        # [conf] destination — strip prefix
        dest="${dest_raw#\[conf\]  }"
      fi

      local -a _rsync_opts=(-aAXh --progress)
      [[ "$backup_action" == "🔍"* ]] && _rsync_opts+=(--dry-run)
      [[ -f "$_excludes" ]] && _rsync_opts+=(--exclude-from="$_excludes")

      local _log_dir="$HOME/.local/share/rig"
      local _log_file="$_log_dir/backup.log"
      mkdir -p "$_log_dir"

      gum style --foreground 214 "  Source:      $_backup_src"
      gum style --foreground 214 "  Destination: $dest"
      [[ "$backup_action" == "🔍"* ]] && \
        gum style --foreground 226 "  DRY RUN — no files will be written"
      echo ""
      if [[ "$backup_action" == "▶️"* ]]; then
        rsync "${_rsync_opts[@]}" "$_backup_src/" "$dest/" 2>&1 | tee "$_log_file"
      else
        rsync "${_rsync_opts[@]}" "$_backup_src/" "$dest/"
      fi
      echo ""
      gum style --foreground 82 "  ✓ Done"; sleep 2
      ;;
    # ── WireGuard ───────────────────────────────────────────────
    *"WireGuard"*)
      wgs
      ;;

    # ── Cheat sheets ────────────────────────────────────────────
    *"Cheat sheets")
      gum style --foreground 214 "  Loading cht.sh command list (may take a moment)..."
      local cmds
      cmds=$(curl -sL https://cht.sh/:list 2>/dev/null | grep -v '^:' | grep -v '^$' | sort)
      if [[ -z "$cmds" ]]; then
        gum style --foreground 196 "  Could not connect to cheat.sh"; sleep 2
      else
        while true; do
          local cmd
          cmd=$(echo "$cmds" | fzf \
            --header 'Search command | Enter: view | Esc: back' \
            --preview 'bash -c "curl -sL https://cht.sh/{} 2>/dev/null | head -50"' \
            --preview-window 'right:60%' --height 80% --border --tiebreak=begin)
          [[ -z "$cmd" ]] && break   # Esc → back to main loop
          curl -sL "https://cht.sh/$cmd" 2>/dev/null | less -R
        done
      fi
      ;;

    # ── Environment variables ───────────────────────────────────
    *"Environment variables")
      tv env
      ;;

    # ── Weather ─────────────────────────────────────────────────
    *"Weather"*)
      local location=""
      if [[ -n "${RIG_WEATHER_CITIES:-}" ]]; then
        local _city_menu=()
        local IFS='|'
        for _city in $RIG_WEATHER_CITIES; do
          _city_menu+=("$_city")
        done
        unset IFS
        _city_menu+=("Enter location manually")
        local weather_action
        weather_action=$(gum choose \
          --header "  Weather — choose location  (Esc: back)" \
          "${_city_menu[@]}")
        [[ -z "$weather_action" ]] && continue
        if [[ "$weather_action" == "Enter location manually" ]]; then
          location=$(gum input --placeholder "City (e.g. London, Tokyo, Berlin)...")
        else
          location="$weather_action"
        fi
      else
        location=$(gum input --placeholder "City (e.g. London, Tokyo, Berlin)...")
      fi
      [[ -z "$location" ]] && continue
      gum style --foreground 214 "  Fetching weather for $location..."
      curl -s "wttr.in/$location" 2>/dev/null | less -R
      ;;

    esac
    # ── End of case: loop continues → back to main menu ─────────

  done

  # ── Clean up trap before returning ───────────────────────────
  trap - INT
}

# =============================================================================
# Hosts management helpers
# hosts.conf format (one per line):  name|user|host|port|description
# =============================================================================

# ── Return path to hosts file, creating it if missing ────────────────────────
function _rig_hosts_file() {
  local hf="${RIG_HOSTS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/rig/hosts.conf}"
  mkdir -p "$(dirname "$hf")"
  [[ ! -f "$hf" ]] && printf '# rig saved hosts\n# format: name|user|host|port|description\n' > "$hf"
  echo "$hf"
}

# ── sshub helpers ────────────────────────────────────────────────────────────
function _rig_sshub_available() {
  command -v sshub &>/dev/null
}

# Given an sshub host name, print "user|host|port"
function _rig_sshub_resolve() {
  local _name="$1" _info _user _host _port
  _info=$(sshub host show "$_name" --format plain 2>/dev/null)
  _user=$(echo "$_info" | awk -F': ' '/^User:/{print $2}')
  _host=$(echo "$_info" | awk -F': ' '/^Address:/{print $2}')
  _port=$(echo "$_info" | awk -F': ' '/^Port:/{print $2}')
  echo "${_user:-$USER}|${_host:-$_name}|${_port:-22}"
}

# Pick an sshub host; prints "sshub|name"
function _rig_sshub_pick() {
  local header="${1:-Select sshub host}" _name
  _name=$(sshub host list --format plain 2>/dev/null \
    | fzf --header "$header  (Esc: back)" \
          --preview 'sshub host show {} --format plain 2>/dev/null' \
          --preview-window 'right:40%' \
          --height 80% --border)
  [[ -z "$_name" ]] && return 0
  echo "sshub|${_name}"
}

# ── Unified host picker: saved hosts + ~/.ssh/config entries ──────────────────
# Prints: "type|name|user|host|port"
# type = "saved", "config" or "sshub"
function _rig_hosts_pick() {
  local header="${1:-Select host}"

  # Prefer sshub when enabled and available
  if [[ "$RIG_USE_SSHUB" == true ]] && _rig_sshub_available; then
    _rig_sshub_pick "$header"
    return 0
  fi

  local hf; hf=$(_rig_hosts_file)
  local ssh_cfg="${RIG_SSH_CONFIG:-$HOME/.ssh/config}"
  local -a _lines=()

  # Saved rig hosts
  while IFS='|' read -r _n _u _h _p _d || [[ -n "$_n" ]]; do
    [[ "$_n" == \#* || -z "$_n" ]] && continue
    _lines+=("[saved]  ${_n}  —  ${_u}@${_h}:${_p}  ${_d}")
  done < "$hf"

  # ssh/config hosts
  if [[ -f "$ssh_cfg" ]]; then
    while read -r _alias; do
      _lines+=("[config] ${_alias}  —  from ~/.ssh/config")
    done < <(grep -E '^Host ' "$ssh_cfg" | grep -v '[*?]' | awk '{print $2}')
  fi

  [[ ${#_lines[@]} -eq 0 ]] && {
    gum style --foreground 196 "  No hosts found. Add one via 'Manage saved hosts'."
    sleep 2; return 0
  }

  local selected
  selected=$(printf '%s\n' "${_lines[@]}" \
    | fzf --header "$header  (Esc: back)" \
          --preview "
            line={}
            if [[ \$line == '[saved]'* ]]; then
              name=\$(echo \$line | awk '{print \$2}')
              grep \"^\$name|\" \"$hf\" 2>/dev/null | awk -F'|' '{printf \"Name: %s\nUser: %s\nHost: %s\nPort: %s\nDesc: %s\n\",\$1,\$2,\$3,\$4,\$5}'
            else
              alias=\$(echo \$line | awk '{print \$2}')
              grep -A 8 \"^Host \$alias\$\" \"$ssh_cfg\" 2>/dev/null
            fi" \
          --preview-window 'right:40%' \
          --height 80% --border)
  [[ -z "$selected" ]] && return 0

  # Parse and return structured data
  if [[ "$selected" == "[saved]"* ]]; then
    local _sname
    _sname=$(echo "$selected" | awk '{print $2}')
    local _n _u _h _p _d
    while IFS='|' read -r _n _u _h _p _d || [[ -n "$_n" ]]; do
      [[ "$_n" == "$_sname" ]] && { echo "saved|${_n}|${_u}|${_h}|${_p}"; return 0; }
    done < "$hf"
  else
    local _alias
    _alias=$(echo "$selected" | awk '{print $2}')
    echo "config|${_alias}|${_alias}|${_alias}|22"
  fi
}

# ── Build SSH connect string from _rig_hosts_pick output ─────────────────────
# Usage: _rig_hosts_ssh_cmd "saved|name|user|host|port"
# Prints the ssh command arguments
function _rig_hosts_ssh_args() {
  local _type _name _user _host _port
  IFS='|' read -r _type _name _user _host _port <<< "$1"
  if [[ "$_type" == "config" || "$_type" == "sshub" ]]; then
    echo "$_name"   # just the alias, ssh/config or sshub handles the rest
  else
    if [[ "$_port" == "22" ]]; then
      echo "${_user}@${_host}"
    else
      echo "-p ${_port} ${_user}@${_host}"
    fi
  fi
}

# ── Manage saved hosts (CRUD) ─────────────────────────────────────────────────
function _rig_hosts_manage() {
  if [[ "$RIG_USE_SSHUB" == true ]] && _rig_sshub_available; then
    sshub
    return 0
  fi
  local hf; hf=$(_rig_hosts_file)
  while true; do
    local -a _entries=()
    while IFS='|' read -r _n _u _h _p _d || [[ -n "$_n" ]]; do
      [[ "$_n" == \#* || -z "$_n" ]] && continue
      _entries+=("${_n}  ${_u}@${_h}:${_p}  — ${_d}")
    done < "$hf"
    _entries+=("➕  Add new host")

    local selected
    selected=$(printf '%s\n' "${_entries[@]}" \
      | fzf --header "Saved hosts  (Esc: back)" \
            --height 80% --border \
            --preview "
              name=\$(echo {} | awk '{print \$1}')
              grep \"^\$name|\" \"$hf\" 2>/dev/null \
                | awk -F'|' '{printf \"Name: %s\nUser: %s\nHost: %s\nPort: %s\nDesc: %s\n\",\$1,\$2,\$3,\$4,\$5}'
            " \
            --preview-window 'right:40%')
    [[ -z "$selected" ]] && return 0

    if [[ "$selected" == "➕"* ]]; then
      _rig_hosts_add "$hf"; continue
    fi

    local hname
    hname=$(echo "$selected" | awk '{print $1}')
    local host_action
    host_action=$(gum choose \
      --header "  $hname  (Esc: back)" \
      "🔌  Connect" \
      "📝  Edit" \
      "🗑️   Delete")
    case "$host_action" in
      *"Connect"*)
        local _row; _row=$(grep "^${hname}|" "$hf")
        local _n _u _h _p _d
        IFS='|' read -r _n _u _h _p _d <<< "$_row"
        local _args; _args=$(_rig_hosts_ssh_args "saved|${_n}|${_u}|${_h}|${_p}")
        ssh $=_args ;;
      *"Edit"*)
        _rig_hosts_edit "$hf" "$hname" ;;
      *"Delete"*)
        _rig_hosts_delete "$hf" "$hname" ;;
    esac
  done
}

function _rig_hosts_add() {
  local hf="$1"
  echo ""
  gum style --bold "  Add new host"
  local _n _u _h _p _d
  _n=$(gum input --prompt "  name (alias) › " --placeholder "e.g. homelab")
  [[ -z "$_n" ]] && return 0
  # Check duplicate
  if grep -q "^${_n}|" "$hf" 2>/dev/null; then
    gum style --foreground 196 "  Name '$_n' already exists. Use Edit to modify it."; sleep 2; return 0
  fi
  _u=$(gum input --prompt "  user         › " --value "$USER" --placeholder "username")
  [[ -z "$_u" ]] && _u="$USER"
  _h=$(gum input --prompt "  host/IP      › " --placeholder "192.168.1.10 or hostname")
  [[ -z "$_h" ]] && return 0
  _p=$(gum input --prompt "  port         › " --value "22" --placeholder "22")
  [[ -z "$_p" ]] && _p="22"
  _d=$(gum input --prompt "  description  › " --placeholder "optional description")
  echo "${_n}|${_u}|${_h}|${_p}|${_d}" >> "$hf"
  gum style --foreground 82 "  ✓ Saved: $_n (${_u}@${_h}:${_p})"
  sleep 1
}

function _rig_hosts_edit() {
  local hf="$1" hname="$2"
  local _row; _row=$(grep "^${hname}|" "$hf")
  [[ -z "$_row" ]] && return 0
  local _n _u _h _p _d
  IFS='|' read -r _n _u _h _p _d <<< "$_row"
  echo ""
  gum style --bold "  Edit host: $_n"
  local _nu _nh _np _nd
  _nu=$(gum input --prompt "  user        › " --value "$_u")
  _nh=$(gum input --prompt "  host/IP     › " --value "$_h")
  _np=$(gum input --prompt "  port        › " --value "$_p")
  _nd=$(gum input --prompt "  description › " --value "$_d")
  # Replace line in file
  local _new="${_n}|${_nu:-$_u}|${_nh:-$_h}|${_np:-$_p}|${_nd}"
  # Use temp file for portability
  local _tmp; _tmp=$(mktemp)
  grep -v "^${hname}|" "$hf" > "$_tmp"
  echo "$_new" >> "$_tmp"
  mv "$_tmp" "$hf"
  gum style --foreground 82 "  ✓ Updated: $_n"; sleep 1
}

function _rig_hosts_delete() {
  local hf="$1" hname="$2"
  if gum confirm "Delete host '$hname'?"; then
    local _tmp; _tmp=$(mktemp)
    grep -v "^${hname}|" "$hf" > "$_tmp"
    mv "$_tmp" "$hf"
    gum style --foreground 82 "  ✓ Deleted: $hname"; sleep 1
  fi
}

# =============================================================================
# SSH action helpers (all use _rig_hosts_pick)
# =============================================================================

# ── SSH: Connect ─────────────────────────────────────────────────────────────
function _rig_ssh_connect() {
  local picked; picked=$(_rig_hosts_pick "Connect to host")
  [[ -z "$picked" ]] && return 0
  local _type _name _user _host _port
  IFS='|' read -r _type _name _user _host _port <<< "$picked"

  local action
  action=$(gum choose --header "  SSH → $_name  (Esc: back)" \
    "Connect" "New tmux window")
  [[ -z "$action" ]] && return 0

  if [[ "$_type" == "sshub" ]]; then
    case "$action" in
      "Connect")         sshub host connect "$_name" ;;
      "New tmux window") tmux new-window -n "$_name" "sshub host connect $_name" ;;
    esac
  else
    local _args; _args=$(_rig_hosts_ssh_args "$picked")
    case "$action" in
      "Connect")         ssh $=_args ;;
      "New tmux window") tmux new-window -n "$_name" "ssh $_args" ;;
    esac
  fi
}

# ── SSH: sshfs mount ─────────────────────────────────────────────────────────
function _rig_ssh_sshfs() {
  if ! command -v sshfs &>/dev/null; then
    gum style --foreground 196 "  sshfs is not installed."; sleep 2; return 0
  fi
  local picked; picked=$(_rig_hosts_pick "Select host to mount")
  [[ -z "$picked" ]] && return 0
  local _type _name _user _host _port
  IFS='|' read -r _type _name _user _host _port <<< "$picked"

  if [[ "$_type" == "sshub" ]]; then
    local _resolved
    _resolved=$(_rig_sshub_resolve "$_name")
    IFS='|' read -r _user _host _port <<< "$_resolved"
  fi

  local remote_dir
  remote_dir=$(gum input --value "/home/$_user" --prompt "  remote dir  › " \
    --placeholder "Remote directory")
  [[ -z "$remote_dir" ]] && return 0

  local mount_point
  mount_point=$(gum input --value "$HOME/mnt/$_name" --prompt "  mount point › " \
    --placeholder "Local mount point (created if missing)")
  [[ -z "$mount_point" ]] && return 0

  [[ ! -d "$mount_point" ]] && mkdir -p "$mount_point" \
    && gum style --foreground 82 "  ✓ Created $mount_point"

  gum style --foreground 214 "  Mounting ${_user}@${_host}:$remote_dir → $mount_point..."
  if sshfs -p "$_port" "${_user}@${_host}:${remote_dir}" "$mount_point"; then
    gum style --foreground 82 "  ✓ Mounted — unmount with: fusermount -u $mount_point"
  else
    gum style --foreground 196 "  ✗ Mount failed"
  fi
  sleep 3
}

# ── SSH: SOCKS proxy tunnel ───────────────────────────────────────────────────
function _rig_ssh_socks() {
  local picked; picked=$(_rig_hosts_pick "Select host for SOCKS proxy")
  [[ -z "$picked" ]] && return 0
  local _type _name _user _host _port
  IFS='|' read -r _type _name _user _host _port <<< "$picked"

  if [[ "$_type" == "sshub" ]]; then
    local _resolved
    _resolved=$(_rig_sshub_resolve "$_name")
    IFS='|' read -r _user _host _port <<< "$_resolved"
  fi

  local port
  port=$(gum input --value "1080" --prompt "  local SOCKS port › " --placeholder "1080")
  [[ -z "$port" ]] && return 0

  gum style --foreground 214 "  SOCKS proxy via $_name on localhost:$port"
  gum style --foreground 245 "  Configure browser/app: SOCKS5 → localhost:$port"
  gum style --foreground 245 "  Ctrl+C to stop."
  sleep 1
  local _args
  if [[ "$_type" == "sshub" ]]; then
    _args="-p $_port ${_user}@${_host}"
  else
    _args=$(_rig_hosts_ssh_args "$picked")
  fi
  ssh -D "$port" -N -C $=_args
}

# ── SSH: port forward tunnel ──────────────────────────────────────────────────
function _rig_ssh_tunnel() {
  local picked; picked=$(_rig_hosts_pick "Select SSH host for tunnel")
  [[ -z "$picked" ]] && return 0
  local _type _name _user _host _port
  IFS='|' read -r _type _name _user _host _port <<< "$picked"

  if [[ "$_type" == "sshub" ]]; then
    local _resolved
    _resolved=$(_rig_sshub_resolve "$_name")
    IFS='|' read -r _user _host _port <<< "$_resolved"
  fi

  local direction
  direction=$(gum choose --header "  Tunnel direction  (Esc: back)" \
    "-L  Local → Remote   (access a remote service locally)" \
    "-R  Remote → Local   (expose a local service remotely)")
  [[ -z "$direction" ]] && return 0

  local local_port remote_host remote_port
  local_port=$(gum input  --prompt "  local port   › " --placeholder "e.g. 8080")
  [[ -z "$local_port" ]] && return 0
  remote_host=$(gum input --value "localhost" --prompt "  remote host  › " \
    --placeholder "localhost or 10.0.0.x")
  [[ -z "$remote_host" ]] && return 0
  remote_port=$(gum input --prompt "  remote port  › " --placeholder "e.g. 5432")
  [[ -z "$remote_port" ]] && return 0

  local flag="-L"
  [[ "$direction" == "-R"* ]] && flag="-R"

  local _args
  if [[ "$_type" == "sshub" ]]; then
    _args="-p $_port ${_user}@${_host}"
  else
    _args=$(_rig_hosts_ssh_args "$picked")
  fi
  gum style --foreground 214 \
    "  Tunnel: ssh $flag ${local_port}:${remote_host}:${remote_port} $_args"
  gum style --foreground 245 "  Ctrl+C to stop."
  sleep 1
  ssh "$flag" "${local_port}:${remote_host}:${remote_port}" -N -C $=_args
}

# ── SSH: run remote app locally (X11 forwarding) ─────────────────────────────
function _rig_ssh_remote_app() {
  local picked; picked=$(_rig_hosts_pick "Select host for remote app")
  [[ -z "$picked" ]] && return 0
  local _type _name _user _host _port
  IFS='|' read -r _type _name _user _host _port <<< "$picked"

  if [[ "$_type" == "sshub" ]]; then
    local _resolved
    _resolved=$(_rig_sshub_resolve "$_name")
    IFS='|' read -r _user _host _port <<< "$_resolved"
  fi

  local app
  app=$(gum input --prompt "  remote command › " \
    --placeholder "e.g. firefox, xterm, code, gimp")
  [[ -z "$app" ]] && return 0

  local _args
  if [[ "$_type" == "sshub" ]]; then
    _args="-p $_port ${_user}@${_host}"
  else
    _args=$(_rig_hosts_ssh_args "$picked")
  fi
  gum style --foreground 214 "  Launching $app via X11 forwarding..."
  sleep 1
  ssh -X -C $=_args "DISPLAY=:0 $app" &
  local _pid=$!
  gum style --foreground 82 "  ✓ $app launched (PID $_pid)"
  gum style --foreground 245 "  Runs in background. Close the app window to stop."
  sleep 3
}

# ── Backup: pick SSH host (legacy, kept for compat) ───────────────────────────
function _rig_backup_pick_ssh_dest() {
  local picked; picked=$(_rig_hosts_pick "Select SSH host for backup")
  [[ -z "$picked" ]] && return 0
  local _type _name _user _host _port
  IFS='|' read -r _type _name _user _host _port <<< "$picked"
  local remote_path
  remote_path=$(gum input --value "/home/$_user" \
    --prompt "  remote backup path › " --placeholder "Remote directory")
  [[ -z "$remote_path" ]] && return 0
  echo "${_user}@${_host}:${remote_path}"
}


# =============================================================================
# Tmux / Sesh helpers
# =============================================================================

# ── Connect to existing session via sesh ─────────────────────────────────────
function _rig_tmux_connect() {
  if ! command -v sesh &>/dev/null; then
    gum style --foreground 196 "  sesh is not installed."; sleep 2; return 0
  fi
  local session
  session=$(sesh list \
    | fzf --header "Connect to session  (Esc: back)" \
          --height 80% --border \
          --preview 'tmux list-windows -t {} 2>/dev/null || echo "Not a tmux session"')
  [[ -z "$session" ]] && return 0
  sesh connect "$session"
}

# ── Create new session ────────────────────────────────────────────────────────
function _rig_tmux_new() {
  local name
  name=$(gum input --prompt "  session name › " \
    --value "$(basename "$PWD")" \
    --placeholder "session name")
  [[ -z "$name" ]] && return 0

  local start_dir
  start_dir=$(gum input --prompt "  start dir    › " \
    --value "$PWD" \
    --placeholder "starting directory")
  [[ -z "$start_dir" ]] && start_dir="$PWD"

  if tmux has-session -t "$name" 2>/dev/null; then
    gum style --foreground 226 "  Session '$name' already exists — connecting..."
    sleep 1
  else
    tmux new-session -d -s "$name" -c "$start_dir"
    gum style --foreground 82 "  ✓ Created session: $name"
    sleep 1
  fi

  # Attach or switch depending on context
  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$name"
  else
    tmux attach-session -t "$name"
  fi
}

# ── Kill session ──────────────────────────────────────────────────────────────
function _rig_tmux_kill() {
  if ! command -v sesh &>/dev/null; then
    gum style --foreground 196 "  sesh is not installed."; sleep 2; return 0
  fi

  local sessions
  sessions=$(tmux list-sessions -F "#{session_name}  [#{session_windows} windows]  #{?session_attached,(attached),}" 2>/dev/null)
  [[ -z "$sessions" ]] && { gum style --foreground 196 "  No tmux sessions running."; sleep 2; return 0; }

  local selected
  selected=$(echo "$sessions" \
    | fzf --header "Select session to kill  (Esc: back)" \
          --height 80% --border \
          --preview 'tmux list-windows -t $(echo {} | awk "{print \$1}") 2>/dev/null')
  [[ -z "$selected" ]] && return 0

  local session_name
  session_name=$(echo "$selected" | awk '{print $1}')

  if gum confirm "Kill session '$session_name'?"; then
    tmux kill-session -t "$session_name"
    gum style --foreground 82 "  ✓ Killed: $session_name"; sleep 1
  fi
}

# ── Launch workflow template ──────────────────────────────────────────────────
function _rig_tmux_template() {
  local tpl_global="${RIG_TEMPLATES_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/rig/templates}"
  local tpl_local="$PWD/.rig"

  # Entries format: "FULL_PATH\tDISPLAY_LABEL"
  # fzf shows only col 2 (--with-nth 2), preview and extraction use col 1
  local -a _entries=()
  if [[ -d "$tpl_local" ]]; then
    for f in "$tpl_local"/*.sh; do
      [[ -f "$f" ]] || continue
      _entries+=("${f}"$'\t'"[local]  $(basename "${f%.sh}")")
    done
  fi
  if [[ -d "$tpl_global" ]]; then
    for f in "$tpl_global"/*.sh; do
      [[ -f "$f" ]] || continue
      _entries+=("${f}"$'\t'"[global] $(basename "${f%.sh}")")
    done
  fi

  if [[ ${#_entries[@]} -eq 0 ]]; then
    gum style --foreground 196 "  No templates found."
    gum style --foreground 245 "  Place .sh files in:"
    gum style --foreground 245 "    Local:  $PWD/.rig/"
    gum style --foreground 245 "    Global: $tpl_global/"
    sleep 3; return 0
  fi

  local selected
  selected=$(printf '%s\n' "${_entries[@]}" \
    | fzf --header "Select workflow template  (Esc: back)" \
          --height 80% --border \
          --delimiter $'\t' \
          --with-nth 2 \
          --preview 'head -50 {1}' \
          --preview-window 'right:55%')
  [[ -z "$selected" ]] && return 0

  local tpl_path
  tpl_path=$(printf '%s' "$selected" | cut -f1)

  if [[ ! -f "$tpl_path" ]]; then
    gum style --foreground 196 "  Template not found: $tpl_path"; sleep 2; return 0
  fi

  # Ask for project directory — default is $PWD
  local proj_dir
  proj_dir=$(gum input \
    --prompt "  project dir › " \
    --value "$PWD" \
    --placeholder "Path to your project")
  [[ -z "$proj_dir" ]] && return 0
  proj_dir="${proj_dir/#\~/$HOME}"

  if [[ ! -d "$proj_dir" ]]; then
    gum style --foreground 196 "  Directory not found: $proj_dir"; sleep 2; return 0
  fi

  gum style --foreground 214 "  Launching: $(basename "${tpl_path%.sh}")"
  gum style --foreground 245 "  Project:   $proj_dir"
  echo ""
  bash "$tpl_path" "$proj_dir" "$(basename "$proj_dir")"
}

# Usage: _rig_log_menu <path_or_special> [source_cmd]
# Special names: "journalctl-boot", "dmesg"
function _rig_log_menu() {
  local name="$1"
  local source="${2:-$name}"
  local needs_sudo=false
  local action log_content

  case "$name" in
    "/var/log"*|nginx*|httpd*|apache*) needs_sudo=true ;;
    dmesg)                              needs_sudo=true ;;
  esac

  action=$(gum choose \
    --header "  $name  (Esc: back)" \
    "🔍  Search (fzf + bat)" \
    "📡  Follow live (tail -f)")
  [[ -z "$action" ]] && return 0

  case "$action" in
    "🔍  Search"*)
      case "$name" in
        "journalctl-boot") log_content=$(journalctl -b --no-pager 2>/dev/null) ;;
        "dmesg")
          [[ "$needs_sudo" == true ]] \
            && log_content=$(sudo dmesg 2>/dev/null) \
            || log_content=$(dmesg 2>/dev/null) ;;
        *)
          [[ "$needs_sudo" == true ]] \
            && log_content=$(sudo cat "$source" 2>/dev/null) \
            || log_content=$(cat "$source" 2>/dev/null) ;;
      esac
      if [[ -n "$log_content" ]]; then
        echo "$log_content" | fzf --ansi \
          --header 'Esc: back | Enter: select line' \
          --height 80% --border \
          --preview 'echo {}' \
          --preview-window 'down:3:hidden' \
          --bind 'enter:accept'
      else
        gum style --foreground 196 "  Could not read log (permission denied?)"; sleep 2
      fi
      ;;
    "📡  Follow live"*)
      echo "  📡 Following $name (Ctrl+C to stop — returns to rig)..."
      sleep 1
      case "$name" in
        "journalctl-boot") journalctl -b -f --output=short-precise ;;
        "dmesg")
          [[ "$needs_sudo" == true ]] && sudo dmesg -w || dmesg -w ;;
        *)
          [[ "$needs_sudo" == true ]] && sudo tail -f "$source" || tail -f "$source" ;;
      esac
      ;;
  esac
}

# ── Helper: process management menu ──────────────────────────────────────────
function _rig_process_menu() {
  local pid="$1"
  local pname="$2"
  while true; do
    local action
    action=$(gum choose \
      --header "  PID $pid ($pname)  (Esc: back)" \
      "💀  Kill process" \
      "📋  View details (ps -f)" \
      "🌳  Process tree (pstree)" \
      "📁  Open files (lsof)" \
      "🔄  Change priority (renice)")
    [[ -z "$action" ]] && return 0   # Esc → back to process list
    case "$action" in
      "💀  Kill process")
        local sig
        sig=$(gum choose \
          --header "  Signal for PID $pid  (Esc: back)" \
          "SIGTERM (15) — graceful" \
          "SIGKILL (9)  — force" \
          "SIGINT (2)   — interrupt")
        [[ -z "$sig" ]] && continue
        case "$sig" in
          *"SIGTERM"*)
            kill    "$pid" 2>/dev/null \
              && gum style --foreground 82  "  ✓ SIGTERM → PID $pid" \
              || gum style --foreground 196 "  ✗ Could not kill PID $pid" ;;
          *"SIGKILL"*)
            kill -9 "$pid" 2>/dev/null \
              && gum style --foreground 82  "  ✓ SIGKILL → PID $pid" \
              || gum style --foreground 196 "  ✗ Could not kill PID $pid" ;;
          *"SIGINT"*)
            kill -2 "$pid" 2>/dev/null \
              && gum style --foreground 82  "  ✓ SIGINT → PID $pid" \
              || gum style --foreground 196 "  ✗ Could not interrupt PID $pid" ;;
        esac
        sleep 1 ;;
      "📋  View details"*)  ps -f -p "$pid" 2>/dev/null | less -R ;;
      "🌳  Process tree"*)  pstree -p "$pid" 2>/dev/null | less -R ;;
      "📁  Open files"*)    lsof -p "$pid" 2>/dev/null | head -100 | less -R ;;
      "🔄  Change priority"*)
        local nice_val
        nice_val=$(gum input --placeholder "Nice value (-20 to 19, lower = higher priority)")
        if [[ "$nice_val" =~ ^-?[0-9]+$ && "$nice_val" -ge -20 && "$nice_val" -le 19 ]]; then
          renice "$nice_val" -p "$pid" 2>/dev/null \
            && gum style --foreground 82  "  ✓ Priority → $nice_val for PID $pid" \
            || gum style --foreground 196 "  ✗ Could not change priority (permission denied?)"
        else
          gum style --foreground 196 "  Invalid value. Must be between -20 and 19"
        fi
        sleep 1 ;;
    esac
  done
}

# ── Keybinding: Ctrl+Space launches rig from any prompt ──────────────────────
function _rig_widget() {
  rig
  zle reset-prompt
}
zle -N _rig_widget
bindkey '^[r' _rig_widget    # Alt+r  (Ctrl+Space es el prefix de tmux)
