# =============================================================================
# rig — Terminal Resource Interactive Guide
# Add to .zshrc:  source ~/.config/zsh/rig.zsh  (or wherever your dotfiles are)
#
# IMPORTANT: must be a function (not a script) so that cd works
# in the parent shell.
#
# Navigation:
#   Esc on a submenu  → back to main menu
#   Esc on main menu  → exit rig
#   Q (Quit option)   → exit rig
#   Ctrl+C            → exit rig cleanly from anywhere
# =============================================================================

function rig() {

  # ── Ctrl+C → clean exit from anywhere inside rig ─────────────────────────
  trap 'trap - INT; return 0' INT

  # ── Load configuration (generated by install.sh) ─────────────────────────
  local _conf="${XDG_CONFIG_HOME:-$HOME/.config}/rig/rig.conf"
  if [[ -f "$_conf" ]]; then
    source "$_conf"
  else
    # Defaults: everything enabled when no config file is present
    RIG_NAV_FILES=true; RIG_NAV_DIRS=true; RIG_NAV_DIRS_ZOXIDE=true; RIG_NAV_TEXT=true
    RIG_DEV_DOCKER=true; RIG_DEV_DJANGO=true; RIG_DEV_PYTHON=true; RIG_DEV_GIT=true
    RIG_SYS_LOGS=true; RIG_SYS_SYSTEMD=true; RIG_SYS_PROCS=true
    RIG_NET_PORTS=true; RIG_NET_SSH=true; RIG_NET_WG=true
    RIG_TOOL_CHEAT=true; RIG_TOOL_ENV=true; RIG_TOOL_WEATHER=true
    RIG_DJANGO_LOG="logs/django.log"
  fi

  # ── gum colors / styles ───────────────────────────────────────────────────
  local GUM_CHOOSE_CURSOR_FOREGROUND="212"   # pink
  local GUM_CHOOSE_SELECTED_FOREGROUND="212"
  local GUM_CHOOSE_HEADER_FOREGROUND="99"    # violet

  # ── Build menu (once, before the loop) ───────────────────────────────────
  local _menu=()
  [[ "$RIG_NAV_FILES"    == true ]] && _menu+=("[nav]   📁  Browse files")
  [[ "$RIG_NAV_DIRS"     == true ]] && _menu+=("[nav]   📂  Browse directories (cd)")
  [[ "$RIG_NAV_TEXT"     == true ]] && _menu+=("[nav]   🔍  Search file contents")
  [[ "$RIG_DEV_DOCKER"   == true ]] && _menu+=("[dev]   🐋  Docker")
  [[ "$RIG_DEV_DJANGO"   == true ]] && _menu+=("[dev]   🐍  Django (current project)")
  [[ "$RIG_DEV_PYTHON"   == true ]] && _menu+=("[dev]   🐍  Python venvs / uv")
  [[ "$RIG_DEV_GIT"      == true ]] && _menu+=("[dev]   🔀  Git")
  [[ "$RIG_SYS_LOGS"     == true ]] && _menu+=("[sys]   📋  System logs")
  [[ "$RIG_SYS_SYSTEMD"  == true ]] && _menu+=("[sys]   ⚙️   Systemd services")
  [[ "$RIG_SYS_PROCS"    == true ]] && _menu+=("[sys]   🖥️   Processes")
  [[ "$RIG_NET_PORTS"    == true ]] && _menu+=("[net]   🖧   Ports / Connections")
  [[ "$RIG_NET_SSH"      == true ]] && _menu+=("[net]   🔌  SSH")
  [[ "$RIG_NET_WG"       == true ]] && _menu+=("[net]   🔒  WireGuard (wgs)")
  [[ "$RIG_TOOL_CHEAT"   == true ]] && _menu+=("[tool]  📖  Cheat sheets")
  [[ "$RIG_TOOL_ENV"     == true ]] && _menu+=("[tool]  🌿  Environment variables")
  [[ "$RIG_TOOL_WEATHER" == true ]] && _menu+=("[tool]  🌤️   Weather (wttr.in)")
  _menu+=("[quit]  ❌  Quit")

  # ── Main loop ─────────────────────────────────────────────────────────────
  # Esc on main menu → exit. Esc on any submenu → continue → back here.
  while true; do

    local section
    section=$(printf '%s\n' "${_menu[@]}" \
      | gum filter \
          --header "  rig — type to filter · [nav] [dev] [sys] [net] [tool]" \
          --placeholder "search..." \
          --height 20)

    [[ -z "$section" ]]        && break   # Esc on main menu → exit
    [[ "$section" == *"Quit"* ]] && break   # Q → exit

    case "$section" in

    # ── Files ───────────────────────────────────────────────────
    *"Browse files")
      local scope
      scope=$(gum choose \
        --header "  Browse files from...  (Esc: back)" \
        "Current directory" \
        "Home (~)")
      [[ -z "$scope" ]] && continue
      case "$scope" in
        "Current directory") tv files-open ;;
        "Home (~)")          (cd ~ && tv files-open) ;;
      esac
      ;;

    # ── Directories + cd ────────────────────────────────────────
    *"Browse directories (cd)")
      local scope
      scope=$(gum choose \
        --header "  Navigate directories from...  (Esc: back)" \
        "Current directory" \
        "Home (~)" \
        "Zoxide (history)")
      [[ -z "$scope" ]] && continue
      local target_dir="" base_dir=""
      case "$scope" in
        "Current directory")
          base_dir="$PWD"
          target_dir=$(fd -t d --exclude .git --exclude node_modules \
            --exclude __pycache__ --exclude .venv --exclude target --exclude .cache \
            . 2>/dev/null \
            | fzf --preview 'ls -la --color=always {}' --height 80% --border \
                  --header 'Esc: back')
          [[ -n "$target_dir" ]] && target_dir="${base_dir}/${target_dir}"
          ;;
        "Home (~)")
          base_dir="$HOME"
          target_dir=$(cd ~ && fd -t d --exclude .git --exclude node_modules \
            --exclude __pycache__ --exclude .venv --exclude target --exclude .cache \
            . 2>/dev/null \
            | fzf --preview 'ls -la --color=always {}' --height 80% --border \
                  --header 'Esc: back')
          [[ -n "$target_dir" ]] && target_dir="${base_dir}/${target_dir}"
          ;;
        "Zoxide (history)")
          target_dir=$(zoxide query --interactive 2>/dev/null)
          ;;
      esac
      target_dir=$(echo "$target_dir" | tr -d '\n')
      if [[ -n "$target_dir" && -d "$target_dir" ]]; then
        cd "$target_dir" && echo "  → $target_dir"
      fi
      ;;

    # ── File content search ─────────────────────────────────────
    *"Search file contents")
      local scope
      scope=$(gum choose \
        --header "  Search text in...  (Esc: back)" \
        "Current directory" \
        "Home (~)")
      [[ -z "$scope" ]] && continue
      case "$scope" in
        "Current directory")
          local selection
          selection=$(rg --column --line-number --no-heading --color=always --smart-case \
            --hidden --follow \
            -g '!*.git*' -g '!node_modules' -g '!__pycache__' -g '!.venv' -g '!target' -g '!.cache' \
            . 2>/dev/null \
            | fzf --ansi \
                  --preview 'bat --style=numbers --color=always {1} --highlight-line {2} 2>/dev/null' \
                  --preview-window 'right:60%:+{2}+3/3' \
                  --delimiter ':' \
                  --header 'Recursive search | Enter: select | Esc: back' \
                  --header-first)
          if [[ -n "$selection" ]]; then
            local file=$(echo "$selection" | cut -d':' -f1)
            local line=$(echo "$selection" | cut -d':' -f2)
            echo "📄 $file:$line"
          fi
          ;;
        "Home (~)")
          local selection
          selection=$(cd ~ && rg --column --line-number --no-heading --color=always --smart-case \
            --hidden --follow \
            -g '!*.git*' -g '!node_modules' -g '!__pycache__' -g '!.venv' -g '!target' -g '!.cache' \
            . 2>/dev/null \
            | fzf --ansi \
                  --preview 'cd ~ && bat --style=numbers --color=always {1} --highlight-line {2} 2>/dev/null' \
                  --preview-window 'right:60%:+{2}+3/3' \
                  --delimiter ':' \
                  --header 'Recursive search in home | Enter: select | Esc: back' \
                  --header-first)
          if [[ -n "$selection" ]]; then
            local file=$(echo "$selection" | cut -d':' -f1)
            local line=$(echo "$selection" | cut -d':' -f2)
            echo "📄 ~/$file:$line"
          fi
          ;;
      esac
      ;;

    # ── Docker ──────────────────────────────────────────────────
    *"Docker")
      local docker_action
      docker_action=$(gum choose \
        --header "  Docker  (Esc: back)" \
        "🐳  lazydocker (full TUI)" \
        "📋  Containers (inspect / logs / shell / restart / stop)" \
        "📦  Images" \
        "🌐  Networks" \
        "💾  Volumes" \
        "📝  docker-compose: current project services")
      [[ -z "$docker_action" ]] && continue
      case "$docker_action" in
        "🐳  lazydocker"*)   lazydocker ;;
        "📋  Containers"*)   tv docker-all ;;
        "📦  Images")
          docker images --format '{{.Repository}}:{{.Tag}}\t{{.Size}}\t{{.ID}}' | tv ;;
        "🌐  Networks")
          docker network ls --format '{{.Name}}\t{{.Driver}}\t{{.ID}}' | tv ;;
        "💾  Volumes")
          docker volume ls --format '{{.Name}}\t{{.Driver}}' | tv ;;
        "📝  docker-compose"*)
          if [[ -f "docker-compose.yml" || -f "docker-compose.yaml" || -f "compose.yml" ]]; then
            docker compose ps --format 'table {{.Name}}\t{{.Status}}\t{{.Image}}' | tv
          else
            gum style --foreground 196 "  No docker-compose.yml found in current directory"
            sleep 2
          fi
          ;;
      esac
      ;;

    # ── System logs ─────────────────────────────────────────────
    *"System logs")
      local _log_opts=(
        "journalctl — search services (fzf + preview)"
        "journalctl — follow service live"
        "systemd — boot log"
        "kernel — dmesg"
      )
      local _log_labels=() _log_paths=()
      if [[ -n "${RIG_LOG_FILES:-}" ]]; then
        local IFS='|'
        for _entry in $RIG_LOG_FILES; do
          local _label="${_entry%%:*}"
          local _path="${_entry#*:}"
          _log_labels+=("$_label")
          _log_paths+=("$_path")
          _log_opts+=("$_label")
        done
        unset IFS
      fi
      local log_choice
      log_choice=$(gum choose \
        --header "  System logs — which one?  (Esc: back)" \
        "${_log_opts[@]}")
      [[ -z "$log_choice" ]] && continue
      case "$log_choice" in
        "journalctl — search services"*)
          local unit
          unit=$(systemctl list-units --type=service --all --no-pager --plain 2>/dev/null \
            | awk 'NR>1 && NF>1 {print $1}' \
            | fzf --preview 'journalctl -u {} --no-pager -n 30 --output=short-precise 2>/dev/null' \
                  --preview-window 'right:60%' \
                  --header 'Esc: back | Enter: follow live' \
                  --height 80% --border)
          [[ -n "$unit" ]] && journalctl -u "$unit" -f --output=short-precise
          ;;
        "journalctl — follow service live")
          local unit
          unit=$(systemctl list-units --type=service --all --no-pager --plain 2>/dev/null \
            | awk 'NR>1 && NF>1 {print $1}' \
            | fzf --header 'Select service | Esc: back' --height 80% --border)
          [[ -n "$unit" ]] && journalctl -u "$unit" -f --output=short-precise
          ;;
        "systemd — boot log"*)
          _rig_log_menu "journalctl-boot" "journalctl -b --no-pager" ;;
        "kernel — dmesg"*)
          _rig_log_menu "dmesg" "dmesg" ;;
        *)
          local _i=0
          for _lbl in "${_log_labels[@]}"; do
            if [[ "$log_choice" == "$_lbl" ]]; then
              _rig_log_menu "${_log_paths[$_i]}"
              break
            fi
            (( _i++ ))
          done
          ;;
      esac
      ;;

    # ── Systemd services ────────────────────────────────────────
    *"Systemd services")
      while true; do
        local service_action
        service_action=$(gum choose \
          --header "  Systemd  (Esc: back to main)" \
          "🔍  All services" \
          "🟢  Active (running)" \
          "🔴  Failed")
        [[ -z "$service_action" ]] && break   # Esc → back to main loop

        local list_cmd=""
        case "$service_action" in
          "🔍  All services"*)
            list_cmd="systemctl list-units --type=service --all --no-pager --plain 2>/dev/null | awk 'NR>1 && NF>1 {print \$1, \$3, \$4}'" ;;
          "🟢  Active"*)
            list_cmd="systemctl list-units --type=service --state=running --no-pager --plain 2>/dev/null | awk 'NR>1 && NF>1 {print \$1, \$3, \$4}'" ;;
          "🔴  Failed"*)
            list_cmd="systemctl list-units --type=service --state=failed --no-pager --plain 2>/dev/null | awk 'NR>1 && NF>1 {print \$1, \$3, \$4}'" ;;
        esac

        local selected
        selected=$(eval "$list_cmd" | fzf \
          --header 'Esc: back | Enter: manage service' \
          --preview 'systemctl status {1} 2>/dev/null | head -20' \
          --preview-window 'right:60%' --height 80% --border)
        [[ -z "$selected" ]] && continue   # Esc on list → back to filter

        local service svc_status
        service=$(echo "$selected" | awk '{print $1}')
        svc_status=$(echo "$selected" | awk '{print $2}')

        while true; do
          local action
          action=$(gum choose \
            --header "  $service ($svc_status)  (Esc: back)" \
            "▶️  Start" "⏹️  Stop" "🔄  Restart" \
            "📊  Status" "⚡  Enable" "🚫  Disable")
          [[ -z "$action" ]] && break   # Esc → back to service list
          case "$action" in
            "▶️  Start")
              sudo systemctl start   "$service" 2>/dev/null \
                && gum style --foreground 82  "  ✓ $service started" \
                || gum style --foreground 196 "  ✗ Could not start $service" ;;
            "⏹️  Stop")
              sudo systemctl stop    "$service" 2>/dev/null \
                && gum style --foreground 82  "  ✓ $service stopped" \
                || gum style --foreground 196 "  ✗ Could not stop $service" ;;
            "🔄  Restart")
              sudo systemctl restart "$service" 2>/dev/null \
                && gum style --foreground 82  "  ✓ $service restarted" \
                || gum style --foreground 196 "  ✗ Could not restart $service" ;;
            "📊  Status")   systemctl status "$service" | less -R ;;
            "⚡  Enable")
              sudo systemctl enable  "$service" 2>/dev/null \
                && gum style --foreground 82  "  ✓ $service enabled" \
                || gum style --foreground 196 "  ✗ Could not enable $service" ;;
            "🚫  Disable")
              sudo systemctl disable "$service" 2>/dev/null \
                && gum style --foreground 82  "  ✓ $service disabled" \
                || gum style --foreground 196 "  ✗ Could not disable $service" ;;
          esac
          sleep 1
        done
      done
      ;;

    # ── Django ──────────────────────────────────────────────────
    *"Django (current project)")
      local django_log="${RIG_DJANGO_LOG:-logs/django.log}"
      if [[ ! -f "$django_log" ]]; then
        gum style --foreground 196 "  Log not found: $PWD/$django_log"
        sleep 2
        continue
      fi
      local django_action
      django_action=$(gum choose \
        --header "  Django logs — $PWD/$django_log  (Esc: back)" \
        "Search in logs (tv)" \
        "Follow live (less +F)" \
        "Last 200 lines (bat)" \
        "Errors and exceptions only" \
        "Warnings only")
      [[ -z "$django_action" ]] && continue
      case "$django_action" in
        "Search in logs (tv)")      cat "$django_log" | tv ;;
        "Follow live"*)             less +F "$django_log" ;;
        "Last 200 lines"*)          tail -200 "$django_log" | bat --color=always -l log ;;
        "Errors and exceptions only")
          grep -iE "error|exception|traceback|critical" "$django_log" | tv ;;
        "Warnings only")
          grep -iE "warning|warn" "$django_log" \
            | grep -viE "error|exception|traceback|critical" | tv ;;
      esac
      ;;

    # ── Python venvs / uv ───────────────────────────────────────
    *"Python venvs / uv")
      local venv_action
      venv_action=$(gum choose \
        --header "  Python venvs  (Esc: back)" \
        "📂  List venvs in ~/.venvs" \
        "📂  List venvs in current project" \
        "🔍  Search venvs with fd" \
        "➕  Create new venv (uv venv)")
      [[ -z "$venv_action" ]] && continue
      case "$venv_action" in
        "📂  List venvs in ~/.venvs")
          if [[ -d "$HOME/.venvs" ]]; then
            local venvs selected
            venvs=$(ls -1 "$HOME/.venvs" 2>/dev/null)
            if [[ -z "$venvs" ]]; then
              gum style --foreground 196 "  No venvs found in ~/.venvs"; sleep 2
            else
              selected=$(echo "$venvs" | fzf --header 'Select venv | Esc: back' --height 80% --border)
              [[ -n "$selected" ]] && source "$HOME/.venvs/$selected/bin/activate" \
                && echo "  ✓ Activated: $selected"
            fi
          else
            gum style --foreground 196 "  ~/.venvs does not exist"; sleep 2
          fi
          ;;
        "📂  List venvs in current project")
          local venv_dirs selected
          venv_dirs=$(fd -t d -H -I -E .git -E node_modules -E __pycache__ \
            '^(\.venv|venv|env|\.env)$' . 2>/dev/null)
          if [[ -z "$venv_dirs" ]]; then
            gum style --foreground 196 "  No venvs found in current project"; sleep 2
          else
            selected=$(echo "$venv_dirs" | fzf \
              --header 'Select venv | Esc: back' \
              --preview 'ls -la {}/bin 2>/dev/null | head -10' --height 80% --border)
            [[ -n "$selected" ]] && source "$selected/bin/activate" \
              && echo "  ✓ Activated: $selected"
          fi
          ;;
        "🔍  Search venvs with fd")
          local all_venvs selected
          all_venvs=$(fd -t d -H -I -E .git -E node_modules -E __pycache__ \
            '^(\.venv|venv|env)$' ~ 2>/dev/null | head -20)
          if [[ -z "$all_venvs" ]]; then
            gum style --foreground 196 "  No venvs found"; sleep 2
          else
            selected=$(echo "$all_venvs" | fzf \
              --header 'Select venv | Esc: back' \
              --preview 'ls -la {}/bin 2>/dev/null | head -10' --height 80% --border)
            [[ -n "$selected" ]] && source "$selected/bin/activate" \
              && echo "  ✓ Activated: $selected"
          fi
          ;;
        "➕  Create new venv (uv venv)")
          local venv_name
          venv_name=$(gum input --placeholder "Venv name (e.g. .venv)")
          if [[ -n "$venv_name" ]]; then
            if command -v uv &>/dev/null; then
              uv venv "$venv_name" && echo "  ✓ Created with uv: $venv_name"
            else
              python3 -m venv "$venv_name" && echo "  ✓ Created: $venv_name"
            fi
            gum confirm "Activate now?" && source "$venv_name/bin/activate" \
              && echo "  ✓ Activated"
          fi
          ;;
      esac
      ;;

    # ── Git ─────────────────────────────────────────────────────
    *"Git")
      if ! git rev-parse --git-dir &>/dev/null; then
        gum style --foreground 196 "  Not inside a git repository"
        sleep 2; continue
      fi
      local git_action
      git_action=$(gum choose \
        --header "  Git — $(git rev-parse --show-toplevel | xargs basename)  (Esc: back)" \
        "🦥  gitui (full TUI)" \
        "📝  Log — search commits" \
        "🌿  Branches — checkout" \
        "💾  Stash — view and apply" \
        "📁  Modified files" \
        "🏠  Git repos in ~")
      [[ -z "$git_action" ]] && continue
      case "$git_action" in
        "🦥  gitui"*)         gitui ;;
        "📝  Log"*)           tv git-log ;;
        "🌿  Branches"*)      tv git-branches ;;
        "💾  Stash"*)         tv git-stash ;;
        "📁  Modified files") tv git-modified ;;
        "🏠  Git repos in ~") tv git-repos ;;
      esac
      ;;

    # ── Processes ───────────────────────────────────────────────
    *"Processes")
      while true; do
        local proc_action
        proc_action=$(gum choose \
          --header "  Processes  (Esc: back to main)" \
          "🔍  Browse and manage processes" \
          "📊  Top by CPU" \
          "📊  Top by memory")
        [[ -z "$proc_action" ]] && break   # Esc → back to main loop

        local get_cmd=""
        case "$proc_action" in
          "🔍  Browse"*)        get_cmd="ps aux --sort=-%cpu 2>/dev/null" ;;
          "📊  Top by CPU"*)    get_cmd="ps aux --sort=-%cpu 2>/dev/null | head -50" ;;
          "📊  Top by memory"*) get_cmd="ps aux --sort=-%mem 2>/dev/null | head -50" ;;
        esac

        while true; do
          local selected
          selected=$(eval "$get_cmd" \
            | fzf --header 'Esc: back | Enter: manage process' \
                  --preview 'echo {} | awk "{print \$2}" | xargs -I % sh -c "ps -f -p % 2>/dev/null || echo PID: %"' \
                  --preview-window 'right:50%' --height 80% --border)
          [[ -z "$selected" ]] && break   # Esc → back to process type menu

          local pid pname
          pid=$(echo "$selected" | awk '{print $2}')
          pname=$(echo "$selected" | awk '{print $11}')
          [[ "$pid" =~ ^[0-9]+$ ]] && _rig_process_menu "$pid" "$pname"
        done
      done
      ;;

    # ── Ports / Connections ─────────────────────────────────────
    *"Ports / Connections")
      local port_action
      port_action=$(gum choose \
        --header "  Ports  (Esc: back)" \
        "🔍  Listening ports (ss -tulpn)" \
        "📊  Established connections (ss -tunp)" \
        "🌐  All connections by state (ss -tunap)")
      [[ -z "$port_action" ]] && continue
      case "$port_action" in
        "🔍  Listening ports"*)
          local selected
          selected=$(ss -tulpn 2>/dev/null | grep -v "^Netid" | fzf \
            --header 'Esc: back | Enter: inspect process' \
            --preview 'echo {} | awk "{print \$7}" | grep -oP "pid=\K[0-9]+" | xargs -I % sh -c "ps -f -p % 2>/dev/null || echo No info"' \
            --preview-window 'right:50%' --height 80% --border)
          if [[ -n "$selected" ]]; then
            local pid
            pid=$(echo "$selected" | grep -oP "pid=\K[0-9]+")
            [[ -n "$pid" ]] && _rig_process_menu "$pid" \
              "$(echo "$selected" | awk '{print $7}' | grep -oP 'name=\K[^:]+')"
          fi
          ;;
        "📊  Established connections"*) ss -tunp  2>/dev/null | less -S ;;
        "🌐  All connections"*)         ss -tunap 2>/dev/null | less -S ;;
      esac
      ;;

    # ── SSH ─────────────────────────────────────────────────────
    *"SSH")
      tv ssh-hosts
      ;;

    # ── WireGuard ───────────────────────────────────────────────
    *"WireGuard"*)
      wgs
      ;;

    # ── Cheat sheets ────────────────────────────────────────────
    *"Cheat sheets")
      gum style --foreground 214 "  Loading cht.sh command list (may take a moment)..."
      local cmds
      cmds=$(curl -sL https://cht.sh/:list 2>/dev/null | grep -v '^:' | grep -v '^$' | sort)
      if [[ -z "$cmds" ]]; then
        gum style --foreground 196 "  Could not connect to cheat.sh"; sleep 2
      else
        while true; do
          local cmd
          cmd=$(echo "$cmds" | fzf \
            --header 'Search command | Enter: view | Esc: back' \
            --preview 'bash -c "curl -sL https://cht.sh/{} 2>/dev/null | head -50"' \
            --preview-window 'right:60%' --height 80% --border --tiebreak=begin)
          [[ -z "$cmd" ]] && break   # Esc → back to main loop
          curl -sL "https://cht.sh/$cmd" 2>/dev/null | less -R
        done
      fi
      ;;

    # ── Environment variables ───────────────────────────────────
    *"Environment variables")
      tv env
      ;;

    # ── Weather ─────────────────────────────────────────────────
    *"Weather"*)
      local location=""
      if [[ -n "${RIG_WEATHER_CITIES:-}" ]]; then
        local _city_menu=()
        local IFS='|'
        for _city in $RIG_WEATHER_CITIES; do
          _city_menu+=("$_city")
        done
        unset IFS
        _city_menu+=("Enter location manually")
        local weather_action
        weather_action=$(gum choose \
          --header "  Weather — choose location  (Esc: back)" \
          "${_city_menu[@]}")
        [[ -z "$weather_action" ]] && continue
        if [[ "$weather_action" == "Enter location manually" ]]; then
          location=$(gum input --placeholder "City (e.g. London, Tokyo, Berlin)...")
        else
          location="$weather_action"
        fi
      else
        location=$(gum input --placeholder "City (e.g. London, Tokyo, Berlin)...")
      fi
      [[ -z "$location" ]] && continue
      gum style --foreground 214 "  Fetching weather for $location..."
      curl -s "wttr.in/$location" 2>/dev/null | less -R
      ;;

    esac
    # ── End of case: loop continues → back to main menu ─────────

  done

  # ── Clean up trap before returning ───────────────────────────
  trap - INT
}

# ── Helper: log viewer — search or follow live ────────────────────────────────
# Usage: _rig_log_menu <path_or_special> [source_cmd]
# Special names: "journalctl-boot", "dmesg"
function _rig_log_menu() {
  local name="$1"
  local source="${2:-$name}"
  local needs_sudo=false
  local action log_content

  case "$name" in
    "/var/log"*|nginx*|httpd*|apache*) needs_sudo=true ;;
    dmesg)                              needs_sudo=true ;;
  esac

  action=$(gum choose \
    --header "  $name  (Esc: back)" \
    "🔍  Search (fzf + bat)" \
    "📡  Follow live (tail -f)")
  [[ -z "$action" ]] && return 0

  case "$action" in
    "🔍  Search"*)
      case "$name" in
        "journalctl-boot") log_content=$(journalctl -b --no-pager 2>/dev/null) ;;
        "dmesg")
          [[ "$needs_sudo" == true ]] \
            && log_content=$(sudo dmesg 2>/dev/null) \
            || log_content=$(dmesg 2>/dev/null) ;;
        *)
          [[ "$needs_sudo" == true ]] \
            && log_content=$(sudo cat "$source" 2>/dev/null) \
            || log_content=$(cat "$source" 2>/dev/null) ;;
      esac
      if [[ -n "$log_content" ]]; then
        echo "$log_content" | fzf --ansi \
          --header 'Esc: back | Enter: select line' \
          --height 80% --border \
          --preview 'echo {}' \
          --preview-window 'down:3:hidden' \
          --bind 'enter:accept'
      else
        gum style --foreground 196 "  Could not read log (permission denied?)"; sleep 2
      fi
      ;;
    "📡  Follow live"*)
      echo "  📡 Following $name (Ctrl+C to stop — returns to rig)..."
      sleep 1
      case "$name" in
        "journalctl-boot") journalctl -b -f --output=short-precise ;;
        "dmesg")
          [[ "$needs_sudo" == true ]] && sudo dmesg -w || dmesg -w ;;
        *)
          [[ "$needs_sudo" == true ]] && sudo tail -f "$source" || tail -f "$source" ;;
      esac
      ;;
  esac
}

# ── Helper: process management menu ──────────────────────────────────────────
function _rig_process_menu() {
  local pid="$1"
  local pname="$2"
  while true; do
    local action
    action=$(gum choose \
      --header "  PID $pid ($pname)  (Esc: back)" \
      "💀  Kill process" \
      "📋  View details (ps -f)" \
      "🌳  Process tree (pstree)" \
      "📁  Open files (lsof)" \
      "🔄  Change priority (renice)")
    [[ -z "$action" ]] && return 0   # Esc → back to process list
    case "$action" in
      "💀  Kill process")
        local sig
        sig=$(gum choose \
          --header "  Signal for PID $pid  (Esc: back)" \
          "SIGTERM (15) — graceful" \
          "SIGKILL (9)  — force" \
          "SIGINT (2)   — interrupt")
        [[ -z "$sig" ]] && continue
        case "$sig" in
          *"SIGTERM"*)
            kill    "$pid" 2>/dev/null \
              && gum style --foreground 82  "  ✓ SIGTERM → PID $pid" \
              || gum style --foreground 196 "  ✗ Could not kill PID $pid" ;;
          *"SIGKILL"*)
            kill -9 "$pid" 2>/dev/null \
              && gum style --foreground 82  "  ✓ SIGKILL → PID $pid" \
              || gum style --foreground 196 "  ✗ Could not kill PID $pid" ;;
          *"SIGINT"*)
            kill -2 "$pid" 2>/dev/null \
              && gum style --foreground 82  "  ✓ SIGINT → PID $pid" \
              || gum style --foreground 196 "  ✗ Could not interrupt PID $pid" ;;
        esac
        sleep 1 ;;
      "📋  View details"*)  ps -f -p "$pid" 2>/dev/null | less -R ;;
      "🌳  Process tree"*)  pstree -p "$pid" 2>/dev/null | less -R ;;
      "📁  Open files"*)    lsof -p "$pid" 2>/dev/null | head -100 | less -R ;;
      "🔄  Change priority"*)
        local nice_val
        nice_val=$(gum input --placeholder "Nice value (-20 to 19, lower = higher priority)")
        if [[ "$nice_val" =~ ^-?[0-9]+$ && "$nice_val" -ge -20 && "$nice_val" -le 19 ]]; then
          renice "$nice_val" -p "$pid" 2>/dev/null \
            && gum style --foreground 82  "  ✓ Priority → $nice_val for PID $pid" \
            || gum style --foreground 196 "  ✗ Could not change priority (permission denied?)"
        else
          gum style --foreground 196 "  Invalid value. Must be between -20 and 19"
        fi
        sleep 1 ;;
    esac
  done
}

# ── Keybinding: Ctrl+Space launches rig from any prompt ──────────────────────
function _rig_widget() {
  rig
  zle reset-prompt
}
zle -N _rig_widget
bindkey '^ ' _rig_widget    # Ctrl+Space
